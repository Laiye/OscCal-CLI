{
    "$schema": "osccal.spec.v1",
    "name": "JJF 1057-2026",
    "spec_code": "JJF 1057-2026",
    "title": "数字示波器校准规范",
    "replaces": "JJF 1057-1998",
    "issued": "2026-08-21",
    "effective": "2027-02-21",
    "recall_interval_months": 12,
    "description": "本文件只声明「规范口径」：校准项目、条款号、记录表号与字段、计算公式、参考指标、偏离声明与环境条件。被校仪器的硬件能力来自 characteristics/，校准方法与取点参数来自 schemes/，标准器输出能力来自 calibrators/；三者由 point resolver 合成实际执行点，解析结果（含被跳过的点及原因）写入记录 results.points_plan。",
    "environment": {
        "temperature_c": [
            18,
            28
        ],
        "humidity_rh_max_pct": 80,
        "mains_v": [
            209,
            231
        ],
        "mains_hz": [
            49,
            51
        ],
        "note": "按规范 6.1：温度 (23±5) ℃、相对湿度 ≤80%、电源 (220±11) V (50±1) Hz、周围无电磁干扰与机械振动"
    },
    "deviations": [
        "ΔV（幅度）测量、Δt（时间）测量采用数字示波器自动测量功能读数，代替第 7.11、7.12 条规定的「移动测量光标读数」。",
        "本记录不包含测量不确定度，由实验室依据 JJF 1059.1 另行评定。",
        "第 7.13 条随机噪声测量为人工确认环节：程序暂停并提示操作者接入匹配负载后继续。"
    ],
    "limits_semantics": {
        "kind": "reference_only",
        "note": "规范表 1 注：以上技术指标仅供参考，不作为符合性判定依据。程序只做参考指标比对，不出具合格/不合格结论。"
    },
    "reference_limits": {
        "input_impedance": {
            "ohm_50_pct": 1.0,
            "ohm_1m_pct": 0.5
        },
        "dc_gain": {
            "mpe_pct": 1.0
        },
        "dc_offset": {
            "mpe_pct_of_full_scale": 1.0
        },
        "freq_response_db": {
            "max_ripple_db": 3.0
        },
        "bandwidth": {
            "min_mhz": 1,
            "max_ghz": 50
        },
        "enob_bits": 12,
        "rise_time_ps": {
            "min": 10
        },
        "timebase_rel_error": {
            "from": 1e-06,
            "to": 5e-09
        },
        "square_cal_freq": {
            "mpe_pct": 0.01,
            "range_hz": [
                1000,
                10000000
            ]
        },
        "square_cal_amp": {
            "mpe_pct": 1.0,
            "range_v": [
                0.02,
                2
            ]
        },
        "dc_cal_amp": {
            "mpe_pct": 0.1,
            "range_v": [
                0.02,
                2
            ]
        },
        "delta_v": {
            "mpe_pct_of_reading": 1.0,
            "extra_lsb": 1
        },
        "delta_t": {
            "mpe_pct_of_reading": 0.2,
            "extra_lsb": 1
        },
        "random_noise": {
            "mpe_pct_of_full_scale": 0.1
        }
    },
    "items": {
        "visual_check": {
            "clause": "7.2",
            "title": "外观及工作正常性检查",
            "automatable": false,
            "record_table": "A.1",
            "note": "人工执行：外观检查、通电自检、触发灵敏度与脉宽触发功能检查。程序不实现，仅在记录中留条目与结论字段。"
        },
        "self_cal_signal": {
            "clause": "7.10",
            "title": "自校准信号",
            "automatable": false,
            "record_table": "A.9",
            "note": "需频率计（方波频率）与数字电压表（直流幅度），当前标准器不含，程序不实现。"
        },
        "input_impedance": {
            "clause": "7.3.1",
            "title": "输入阻抗",
            "automatable": true,
            "record_table": "A.2",
            "record_fields": [
                "通道",
                "输入电阻",
                "输入电容",
                "不确定度（另行评定）"
            ]
        },
        "dc_gain": {
            "clause": "7.4.1 / 7.4.2 / 7.4.3",
            "title": "直流增益",
            "automatable": true,
            "record_table": "A.3",
            "record_fields": [
                "通道",
                "量程",
                "直流增益实测值",
                "不确定度（另行评定）"
            ],
            "formula": {
                "std_value": "V = screen_fraction * vertical_div * scale",
                "gain": "G = Vr / V",
                "error_pct": "100 * (G - 1)"
            }
        },
        "dc_offset": {
            "clause": "7.5.1 / 7.5.2",
            "title": "直流偏置",
            "automatable": true,
            "record_table": "A.4",
            "record_fields": [
                "通道",
                "量程",
                "直流偏置标称值",
                "直流偏置实测值",
                "不确定度（另行评定）"
            ],
            "formula": {
                "offset_error": "δd = dr - d0（与记录字段 offset_error_v 同号）",
                "offset_gain": "Gd = dr / d0"
            }
        },
        "freq_response_bandwidth": {
            "clause": "7.6",
            "title": "频率响应、频带宽度",
            "automatable": true,
            "record_table": "A.5",
            "record_fields": [
                "通道",
                "量程",
                "频率值",
                "频率响应实测值",
                "频带宽度",
                "不确定度（另行评定）"
            ],
            "formula": {
                "response": "Gk = Vk / V0  （V0 为 50 kHz 基准幅度）",
                "bandwidth": "G = 0.707 对应的频率；标称带宽处 G ≥ 0.707 即带宽 ≥ 标称"
            }
        },
        "enob": {
            "clause": "7.7",
            "title": "动态有效位数",
            "automatable": true,
            "record_table": "A.6",
            "record_fields": [
                "通道",
                "量程",
                "信号幅度",
                "信号频率",
                "动态有效位数",
                "不确定度（另行评定）"
            ],
            "formula": {
                "fit": "按附录 E 四参数最小二乘拟合 a(i) = E·sin(ω·i·Δt + φ) + d",
                "noise_rms": "Er = sqrt( (1/n) Σ (y(i) - a(i))^2 )",
                "enob": "ENOB = log2( V0 / (√12 · Er) )，V0 为通道量程"
            },
            "pending_confirm": "式 (13)(14)(15) 的确切表达待按正文逐式核对"
        },
        "rise_time": {
            "clause": "7.8",
            "title": "上升时间",
            "automatable": true,
            "record_table": "A.7",
            "record_fields": [
                "通道",
                "量程",
                "参数",
                "实测值",
                "不确定度（另行评定）"
            ],
            "formula": {
                "rise_time": "10%~90% 上升时间实测值",
                "overshoot": "Sb = (顶部最大值 - 阶跃幅度) / 阶跃幅度 × 100%"
            }
        },
        "timebase_error": {
            "clause": "7.9.1 / 7.9.2",
            "title": "时基（采集速率）误差",
            "automatable": true,
            "record_table": "A.8",
            "record_fields": [
                "通道",
                "时基挡位",
                "时基相对误差实测值",
                "不确定度（另行评定）"
            ],
            "formula": {
                "rel_error": "δT = (f_std - f_read) / f_std（正值 = 时基偏慢）",
                "method_two": "按 7.7 拟合的离散角频率换算实际采集速率，式 (19)(20)"
            },
            "pending_confirm": "式 (18)(19)(20) 的确切表达待按正文逐式核对"
        },
        "delta_v": {
            "clause": "7.11",
            "title": "ΔV（幅度）测量",
            "automatable": true,
            "record_table": "A.10",
            "record_fields": [
                "通道",
                "量程",
                "标称值",
                "实测值",
                "不确定度（另行评定）"
            ]
        },
        "delta_t": {
            "clause": "7.12",
            "title": "Δt（时间）测量",
            "automatable": true,
            "record_table": "A.11",
            "record_fields": [
                "通道",
                "量程",
                "标称值",
                "实测值",
                "不确定度（另行评定）"
            ]
        },
        "random_noise": {
            "clause": "7.13",
            "title": "随机噪声",
            "automatable": true,
            "record_table": "A.12",
            "record_fields": [
                "通道",
                "量程",
                "实测值",
                "不确定度（另行评定）"
            ],
            "formula": {
                "method_one": "读幅度有效值（RMS）作为噪声",
                "method_two": "采集数据求标准差"
            }
        }
    },
    "verification": {
        "target_instrument": {
            "model": "MDO3052",
            "manufacturer": "Tektronix",
            "bandwidth_hz": 500000000,
            "channels": 2
        },
        "standard": {
            "calibrator": "Fluke 9500B",
            "head": "9530"
        },
        "rule": "每个校准项目必须在 MDO3052 实机上跑通并记录实测点数与最大偏差，才可在 verification/*.json 中标为 verified；tests 会校验 status=verified 的条目必须带 verified_at、instrument.firmware、points_run、max_abs_error_pct。"
    }
}
