            ],
            "args": [
                [
                    "1",
                    "2",
                    "3",
                    "4"
                ]
            ]
        },
        "get_value_from_item_and_source": {
            "name": "get_value_from_item_and_source",
            "type": "query",
            "commands_num": 2,
            "args_num": 2,
            "commands": [
                ":MEAS:ITEM? ",
                ",CHAN"
