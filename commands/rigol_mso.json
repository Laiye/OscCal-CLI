{
    "name": "RIGOL_MSO",
    "description": "RIGOL MSO5000 series oscilloscope command set, supporting MSO5000",
    "manufacturer": "Rigol",
    "models": ["MSO5072", "MSO5074", "MSO5102", "MSO5104", "MSO5204", "MSO5354"],
    "type": "pyvisa",
    "series": [
        "MSO5000"
    ],
    "feature": {
        "meas": "split",
        "return_value_index": 0,
        "get_value": "ByChannelItem",
        "set_meas": "Channel"
    },
    "keyword": {
        "imp_fif": "FIFT",
        "imp_meg": "OMEG",
        "acquisition_mode_sample": "HORM",
        "acquisition_mode_average": "AVER",
        "acquisition_mode_peak": "PEAK",
        "meas_amp": "VAMP",
        "meas_mean": "VAVG",
        "meas_risetime": "RIS",
        "meas_freq": "FREQ",
        "meas_period": "PER",
        "meas_pos_overshoot": "ROVE",
        "meas_max": "VMAX",
        "meas_min": "VMIN",
        "acquire_stop_after_single": "SING",
        "acquire_stop_after_run_stop": "RUN"
    },
    "actions": {
