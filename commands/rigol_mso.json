            ],
            "args": [
                [
                    "<float>"
                ]
            ]
        },
        "set_horizontal_scale": {
            "name": "set_horizontal_scale",
            "type": "write",
            "commands_num": 1,
            "args_num": 1,
            "commands": [
                ":TIM:SCAL "
            ],
            "args": [
                [
                    "<float>"
                ]
            ]
        },
        "set_acquisition_mode": {
            "name": "set_acquisition_mode",
            "type": "write",
            "commands_num": 1,
