                    "FIFT",
                    "OMEG"
                ]
            ]
        },
        "set_acquire_stop_after": {
            "name": "set_acquire_stop_after",
            "type": "write",
            "commands_num": 1,
            "args_num": 1,
            "commands": [
                ":"
