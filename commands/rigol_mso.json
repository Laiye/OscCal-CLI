            "commands": [
                "*RST\n"
            ],
            "args": []
        },
        "set_channel": {
            "name": "set_channel",
            "type": "write",
            "commands_num": 2,
            "args_num": 2,
            "commands": [
                ":CHAN",
                ":DISP "
            ],
            "args": [
                [
                    "1",
                    "2",
                    "3",
                    "4"
                ],
                [
                    "ON",
                    "OFF"
                ]
            ]
        },
        "set_vertical_scale": {
            "name": "set_vertical_scale",
            "type": "write",
            "commands_num": 2,
            "args_num": 2,
            "commands": [
                ":CHAN",
                ":SCAL "
            ],
            "args": [
                [
                    "1",
                    "2",
                    "3",
                    "4"
                ],
                [
                    "<float>"
                ]
            ]
        },
        "set_trigger_source": {
            "name": "set_trigger_source",
            "type": "write",
